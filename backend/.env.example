# TrackMon Backend Environment Configuration

# Server Port
PORT=4000

# MongoDB Connection String (keep this exclusively in .env, never in Android client)
MONGODB_URI=mongodb://localhost:27017/trackmon

# JWT Secret for authentication tokens (change to a random 64-char string in production)
JWT_SECRET=trackmon_super_secret_jwt_key_replace_in_production_2026

# Token expiration (e.g. 30d, 7d)
JWT_EXPIRES_IN=30d

# Base currency fallback
DEFAULT_BASE_CURRENCY=USD
